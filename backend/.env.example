# ==============================================================================
# KisanVue AI - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Get from https://aistudio.google.com/)
# If empty or invalid, KisanVue AI automatically uses its robust built-in
# Agricultural Diagnostic Simulation Engine so the entire hackathon demo
# continues working without interruption!
GEMINI_API_KEY=

# Gemini Model Selection
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Default Agricultural Monitoring Location (Guntur District, Andhra Pradesh - India's Chilli Capital)
DEFAULT_LAT=16.3067
DEFAULT_LON=80.4365
DEFAULT_LOCATION_NAME=Guntur, Andhra Pradesh, India
